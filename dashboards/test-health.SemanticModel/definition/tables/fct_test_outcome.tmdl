table fct_test_outcome
	lineageTag: 07eb2f49-4598-427f-94c9-975c65967d54

	measure Passed = CALCULATE(COUNTROWS(fct_test_outcome), fct_test_outcome[outcome] = "passed")+0
		formatString: 0
		lineageTag: cf9d871e-870b-453e-b0dd-b490c76df01b

	measure Flaky = CALCULATE(COUNTROWS(fct_test_outcome), fct_test_outcome[outcome] = "flaky")+0
		formatString: 0
		lineageTag: b690dcb1-7ea0-4730-b077-e089b07b2c16

	measure Failed = CALCULATE(COUNTROWS(fct_test_outcome), fct_test_outcome[outcome] = "failed")+0
		formatString: 0
		lineageTag: ae0bc844-6f84-4a73-a770-511c45c7def5

	measure 'Real failures' = CALCULATE([Failed], dim_test[is_intentionally_flaky] = FALSE())+0
		formatString: 0
		lineageTag: 327bae49-456e-4fdd-b558-57509190fb5b

	measure 'Real failures color' = IF([Real failures] > 0, "#D64545", "#2E9E5B")
		lineageTag: 8374e2f8-9afd-4413-b191-6683290f93d0

